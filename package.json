{
  "name": "prehistoric-tribes-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "preview": "npm run preview --workspace=web",
    "lint": "tsc -p web/tsconfig.json --noEmit",
    "test": "npm test --workspace=web",
    "check:size": "node web/scripts/check-file-size.mjs",
    "build:all": "node scripts/build-tauri-all.mjs",
    "build:desktop": "node scripts/build-tauri-all.mjs --desktop",
    "build:android": "node scripts/build-tauri-all.mjs --android",
    "collect:builds": "node scripts/build-tauri-all.mjs --collect-only"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
